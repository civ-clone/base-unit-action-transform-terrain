{
  "name": "@civ-clone/base-unit-action-transform-terrain",
  "version": "0.0.0",
  "description": "The TransformTerrain unit action: a delayed action that changes the terrain of the unit's own tile to what a TerrainConversion lookup rule says it becomes, with criteria for offering it.",
  "repository": "git@github.com:civ-clone/base-unit-action-transform-terrain.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@civ-clone/core-pending-effect": "^0.1.2",
    "@civ-clone/core-player": "^0.1.10",
    "@civ-clone/core-turn-based-game": "^0.1.10",
    "@types/chai": "^4.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.0.0",
    "chai": "^4.0.0",
    "mocha": "^10.0.0",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.0.0"
  },
  "dependencies": {
    "@civ-clone/core-rule": "^0.1.9",
    "@civ-clone/core-terrain": "^0.1.4",
    "@civ-clone/core-unit": "^0.1.32",
    "@civ-clone/core-world": "^0.1.24"
  }
}
